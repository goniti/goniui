{
  "name": "goniui",
  "version": "0.1.0",
  "description": "Neutral, themeable React components for Tailwind CSS v4, built on Radix primitives.",
  "keywords": [
    "react",
    "components",
    "design-system",
    "tailwindcss",
    "radix-ui",
    "ui"
  ],
  "license": "MIT",
  "author": "Goniti",
  "homepage": "https://github.com/goniti/goniui#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/goniti/goniui.git"
  },
  "bugs": {
    "url": "https://github.com/goniti/goniui/issues"
  },
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/styles/index.css",
    "./form": {
      "types": "./dist/molecules/Form/index.d.ts",
      "import": "./dist/molecules/Form/index.js"
    },
    "./faq": {
      "types": "./dist/molecules/FAQ/index.d.ts",
      "import": "./dist/molecules/FAQ/index.js"
    },
    "./carousel": {
      "types": "./dist/molecules/Carousel/index.d.ts",
      "import": "./dist/molecules/Carousel/index.js"
    },
    "./collapsible": {
      "types": "./dist/atoms/Collapsible/index.d.ts",
      "import": "./dist/atoms/Collapsible/index.js"
    },
    "./textarea": {
      "types": "./dist/atoms/Textarea/index.d.ts",
      "import": "./dist/atoms/Textarea/index.js"
    },
    "./calendar": {
      "types": "./dist/molecules/Calendar/index.d.ts",
      "import": "./dist/molecules/Calendar/index.js"
    },
    "./countdown": {
      "types": "./dist/molecules/Countdown/index.d.ts",
      "import": "./dist/molecules/Countdown/index.js"
    },
    "./agenda": {
      "types": "./dist/molecules/Agenda/index.d.ts",
      "import": "./dist/molecules/Agenda/index.js"
    },
    "./date-calendar": {
      "types": "./dist/molecules/DateCalendar/index.d.ts",
      "import": "./dist/molecules/DateCalendar/index.js"
    },
    "./date-agenda": {
      "types": "./dist/molecules/DateAgenda/index.d.ts",
      "import": "./dist/molecules/DateAgenda/index.js"
    },
    "./dialog": {
      "types": "./dist/atoms/Dialog/index.d.ts",
      "import": "./dist/atoms/Dialog/index.js"
    },
    "./dropdown-menu": {
      "types": "./dist/molecules/DropdownMenu/index.d.ts",
      "import": "./dist/molecules/DropdownMenu/index.js"
    },
    "./navbar": {
      "types": "./dist/molecules/Navbar/index.d.ts",
      "import": "./dist/molecules/Navbar/index.js"
    },
    "./navigation-menu": {
      "types": "./dist/molecules/NavigationMenu/index.d.ts",
      "import": "./dist/molecules/NavigationMenu/index.js"
    },
    "./pagination": {
      "types": "./dist/molecules/Pagination/index.d.ts",
      "import": "./dist/molecules/Pagination/index.js"
    },
    "./sidebar": {
      "types": "./dist/molecules/Sidebar/index.d.ts",
      "import": "./dist/molecules/Sidebar/index.js"
    },
    "./table": {
      "types": "./dist/molecules/Table/index.d.ts",
      "import": "./dist/molecules/Table/index.js"
    },
    "./segmented-control": {
      "types": "./dist/molecules/SegmentedControl/index.d.ts",
      "import": "./dist/molecules/SegmentedControl/index.js"
    },
    "./tabs": {
      "types": "./dist/molecules/Tabs/index.d.ts",
      "import": "./dist/molecules/Tabs/index.js"
    },
    "./toast": {
      "types": "./dist/molecules/Toast/index.d.ts",
      "import": "./dist/molecules/Toast/index.js"
    },
    "./sheet": {
      "types": "./dist/molecules/Sheet/index.d.ts",
      "import": "./dist/molecules/Sheet/index.js"
    },
    "./tooltip": {
      "types": "./dist/atoms/Tooltip/index.d.ts",
      "import": "./dist/atoms/Tooltip/index.js"
    },
    "./list": {
      "types": "./dist/atoms/List/index.d.ts",
      "import": "./dist/atoms/List/index.js"
    },
    "./data-table": {
      "types": "./dist/organisms/DataTable/index.d.ts",
      "import": "./dist/organisms/DataTable/index.js"
    },
    "./file-upload": {
      "types": "./dist/molecules/FileUpload/index.d.ts",
      "import": "./dist/molecules/FileUpload/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.test.*",
    "!dist/**/*.stories.*"
  ],
  "publishConfig": {
    "access": "public"
  },
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json && cp -r src/styles dist/styles",
    "test": "vitest run --project unit",
    "test:watch": "vitest --project unit",
    "test:storybook": "vitest run --project storybook",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "check:package": "publint",
    "changeset": "changeset",
    "release": "pnpm build && changeset publish",
    "prepublishOnly": "pnpm build"
  },
  "peerDependencies": {
    "react": "^19",
    "react-dom": "^19",
    "react-hook-form": "^7.55.0",
    "tailwindcss": "^4"
  },
  "peerDependenciesMeta": {
    "react-hook-form": {
      "optional": true
    }
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@radix-ui/react-checkbox": "^1.3.11",
    "@radix-ui/react-collapsible": "^1.1.20",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-navigation-menu": "^1.2.22",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-progress": "^1.1.16",
    "@radix-ui/react-radio-group": "^1.4.7",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-switch": "^1.3.7",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@tanstack/react-table": "^8.21.3",
    "clsx": "^2.1.1",
    "embla-carousel-autoplay": "^8.6.0",
    "embla-carousel-react": "^8.6.0",
    "embla-carousel-wheel-gestures": "^8.1.0",
    "framer-motion": "^12.43.0",
    "lucide-react": "^1.48.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tailwind-variants": "^3.3.1"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@eslint/js": "^10.0.1",
    "@storybook/addon-a11y": "^10.6.0",
    "@storybook/addon-docs": "^10.6.0",
    "@storybook/addon-vitest": "^10.6.0",
    "@storybook/react-vite": "^10.6.0",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/browser-playwright": "4.1.10",
    "@vitest/coverage-v8": "4.1.10",
    "eslint": "^10.11.0",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-boundaries": "^7.2.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-perf": "^3.3.3",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "jsdom": "^29.1.1",
    "playwright": "^1.63.0",
    "prettier": "^3.9.9",
    "publint": "^0.3.15",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-hook-form": "^7.88.0",
    "storybook": "^10.6.0",
    "tailwindcss": "^4.3.3",
    "tsc-alias": "^1.9.5",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.1",
    "vite": "^8.3.1",
    "vitest": "^4.1.11"
  }
}
